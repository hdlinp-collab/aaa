<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="CalcButton.Num"><item name="android:backgroundTint">@color/btn_num</item></style>
    <style name="CalcButton.Fn"><item name="android:backgroundTint">@color/btn_fn</item></style>
    <style name="CalcButton.Op"><item name="android:backgroundTint">@color/btn_op</item></style>
    <style name="CalcButton.Eq"><item name="android:backgroundTint">@color/btn_eq</item></style>
</resources>
